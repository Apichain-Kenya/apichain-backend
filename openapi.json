              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "first_name": {
            "pattern": "^[^\\x00]*$",
            "title": "First Name",
            "type": "string"
          },
          "last_name": {
            "pattern": "^[^\\x00]*$",
            "title": "Last Name",
            "type": "string"
          },
          "number_of_hives": {
            "anyOf": [
              {
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number Of Hives"
          },
          "password": {
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Password",
            "type": "string"
          },
          "phone": {
            "pattern": "^[^\\x00]*$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "phone",
          "password",
          "consent_granted",
          "consent_text_version"
        ],
        "title": "FarmerEnrollRequest",
        "type": "object"
      },
      "FarmerResponse": {
        "properties": {
          "first_name": {
            "title": "First Name",
