          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HoneyType": {
        "description": "Validated here rather than as a PostgreSQL enum, so amending the list is\na one-file edit instead of an `ALTER TYPE` migration (v1 Sprint 8).",
        "enum": [
          "acacia",
          "wildflower",
          "eucalyptus",
          "sunflower",
          "mixed"
        ],
        "title": "HoneyType",
        "type": "string"
      },
      "LoginRequest": {
        "properties": {
          "identifier": {
            "pattern": "^[^\\x00]*$",
            "title": "Identifier",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LogoutRequest": {
