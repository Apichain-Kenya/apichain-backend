        "required": [
          "chain_ok",
          "checked_at",
          "rows_checked"
        ],
        "title": "AuditHealthResponse",
        "type": "object"
      },
      "BatchCreateRequest": {
        "properties": {
          "apiary_id": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Apiary Id",
            "type": "integer"
          },
          "batch_code": {
            "anyOf": [
              {
                "pattern": "^[^\\x00]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Code"
          },
          "farmer_id": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Farmer Id",
            "type": "integer"
          },
          "metadata": {
            "$ref": "#/components/schemas/BatchMetadataInput"
          }
        },
        "required": [
          "farmer_id",
          "apiary_id",
          "metadata"
        ],
        "title": "BatchCreateRequest",
        "type": "object"
      },
      "BatchMetadataInput": {
        "description": "What the farmer declares about a batch at creation \u2014 the S0 pre-image.\n\n`notes` is carried so `/verify` can show it and is deliberately outside the\ncanonical payload, so fixing a typo cannot invalidate anchored history\n(v1 Sprint 8; see `stage_payloads.batch_metadata`).",
        "properties": {
          "apiary_management_method": {
            "$ref": "#/components/schemas/ApiaryManagementMethod"
          },
          "expected_yield_kg": {
            "anyOf": [
              {
                "maximum": 99999999.99,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
                "type": "string"
              }
            ],
            "title": "Expected Yield Kg"
          },
          "harvest_window_end": {
            "format": "date",
            "title": "Harvest Window End",
            "type": "string"
          },
          "harvest_window_start": {
            "format": "date",
            "title": "Harvest Window Start",
            "type": "string"
          },
          "honey_type": {
            "$ref": "#/components/schemas/HoneyType"
          },
          "notes": {
            "anyOf": [
              {
                "pattern": "^[^\\x00]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "required": [
          "honey_type",
          "expected_yield_kg",
          "harvest_window_start",
          "harvest_window_end",
          "apiary_management_method"
        ],
        "title": "BatchMetadataInput",
        "type": "object"
      },
      "BatchResponse": {
        "properties": {
          "batch_code": {
            "title": "Batch Code",
            "type": "string"
          },
          "farmer_id": {
            "title": "Farmer Id",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "batch_code",
          "farmer_id",
          "state"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "OpenAPI shape of the error envelope, so documented error responses match\nwhat the handler emits (keeps the Schemathesis contract test honest).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FarmerEnrollRequest": {
        "properties": {
          "address": {
            "anyOf": [
              {
                "pattern": "^[^\\x00]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "consent_granted": {
            "title": "Consent Granted",
            "type": "boolean"
          },
