{
  "components": {
    "schemas": {
      "AnchorHealthResponse": {
        "description": "Anchor lag, for the uptime check and the Phase 5 alarms (05 \u00a73.6).",
        "properties": {
          "anchor_ok": {
            "title": "Anchor Ok",
            "type": "boolean"
          },
          "last_anchor_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Anchor Id"
          },
          "last_anchored_audit_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Anchored Audit Id"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_run_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Run At"
          },
          "oldest_unanchored_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Unanchored At"
          },
          "pending_anchors": {
            "title": "Pending Anchors",
            "type": "integer"
          },
          "pending_rows": {
            "title": "Pending Rows",
            "type": "integer"
          },
          "waiting_on_audit_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waiting On Audit Id"
          }
        },
        "required": [
          "anchor_ok",
          "pending_rows",
          "pending_anchors"
        ],
        "title": "AnchorHealthResponse",
        "type": "object"
      },
      "AnchorProofEntry": {
        "description": "One audit row of this batch, and the proof for it if one exists yet.",
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "anchor_target": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnchorTarget"
              },
              {
                "type": "null"
              }
            ]
          },
          "anchored_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchored At"
          },
          "audit_id": {
            "title": "Audit Id",
            "type": "integer"
          },
          "merkle_path": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProofStepOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merkle Path"
          },
          "merkle_root": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merkle Root"
          },
          "ots_proof": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ots Proof"
          },
          "row_hash": {
            "title": "Row Hash",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "anchored",
              "confirmed"
            ],
            "title": "Status",
            "type": "string"
          },
          "verified_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          }
        },
        "required": [
          "audit_id",
          "action",
          "row_hash",
          "status"
        ],
        "title": "AnchorProofEntry",
        "type": "object"
      },
      "AnchorProofResponse": {
        "properties": {
          "batch_code": {
            "title": "Batch Code",
            "type": "string"
          },
          "batch_id": {
            "title": "Batch Id",
            "type": "integer"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/AnchorProofEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "status": {
            "enum": [
              "pending",
              "partial",
              "anchored",
              "confirmed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "batch_id",
          "batch_code",
          "status",
          "entries"
        ],
        "title": "AnchorProofResponse",
        "type": "object"
      },
      "AnchorTarget": {
        "description": "Where a Merkle root is published (04 \u00a75.2).\n\nThe target is settled: OpenTimestamps to Bitcoin (05 \u00a76.3). `polygon` is a\nreserved fallback (06 \u00a79) \u2014 the value exists so switching would not need a\nmigration; no code path in v2 consumes it.",
        "enum": [
          "opentimestamps",
          "polygon"
        ],
        "title": "AnchorTarget",
        "type": "string"
      },
      "ApiaryCreateRequest": {
        "properties": {
          "altitude": {
            "anyOf": [
              {
                "maximum": 99999999.99,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Altitude"
          },
          "farmer_id": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Farmer Id",
            "type": "integer"
          },
          "hive_count": {
            "anyOf": [
              {
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hive Count"
          },
          "latitude": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
                "type": "string"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
                "type": "string"
              }
            ],
            "title": "Longitude"
          },
          "name": {
            "pattern": "^[^\\x00]*$",
            "title": "Name",
            "type": "string"
          },
          "vegetation_type": {
            "anyOf": [
              {
                "pattern": "^[^\\x00]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vegetation Type"
          }
        },
        "required": [
          "farmer_id",
          "name",
          "latitude",
          "longitude"
        ],
        "title": "ApiaryCreateRequest",
        "type": "object"
      },
      "ApiaryManagementMethod": {
        "enum": [
          "organic",
          "conventional",
          "regenerative"
        ],
        "title": "ApiaryManagementMethod",
        "type": "string"
      },
      "ApiaryResponse": {
        "properties": {
          "altitude": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Altitude"
          },
          "farmer_id": {
            "title": "Farmer Id",
            "type": "integer"
          },
          "hive_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hive Count"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "latitude": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Latitude",
            "type": "string"
          },
          "longitude": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Longitude",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "vegetation_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vegetation Type"
          }
        },
        "required": [
          "id",
          "farmer_id",
          "name",
          "latitude",
          "longitude",
          "altitude",
          "vegetation_type",
          "hive_count"
        ],
        "title": "ApiaryResponse",
        "type": "object"
      },
      "AuditHealthResponse": {
        "properties": {
          "chain_ok": {
            "title": "Chain Ok",
            "type": "boolean"
          },
          "checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
