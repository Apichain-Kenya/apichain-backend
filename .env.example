# Copy to .env for local dev. Never commit .env.
# Inside docker compose, DATABASE_URL is overridden to point at the db service.
DATABASE_URL=postgresql+psycopg://apichain:apichain@localhost:5433/apichain
FRONTEND_ORIGINS=http://localhost:5173

# --- Phase 3b: media + communications (11 §7). Defaults are the compose
# services; uncomment to change. A *_BACKEND=fake is an explicit opt-in and is
# stamped on every row it touches.
# STORAGE_BACKEND=s3              # or fake (in-memory, lost on restart)
# SCANNER_BACKEND=clamd           # or fake (NOT antivirus; detects EICAR only)
# SMS_BACKEND=fake                # africastalking needs AT_USERNAME / AT_API_KEY
# EMAIL_BACKEND=smtp              # Mailpit on localhost:1025 in dev
# DEV_LOG_MESSAGE_BODIES=true     # dev only: puts verification codes in the log
# VERIFICATION_CODE_PEPPER=change-me-outside-dev
